# Copy to .env. Every value has a working default; override only what you need.

# --- What to talk to ---
# "hardware" prints. "dry" renders a PNG and prints nothing -- use it on a machine
# with no printer attached (a Mac, or CI).
PTOUCH_BACKEND=hardware

# "usb" or "network" (raw port 9100, for the Wi-Fi/network models).
PTOUCH_TRANSPORT=usb

# One of: PT-P710BT, PT-E550W, PT-P750W, PT-P900, PT-P900W, PT-P910BT, PT-P950NW
PTOUCH_MODEL=PT-P710BT

# Only for PTOUCH_TRANSPORT=network.
#PTOUCH_HOST_ADDR=192.168.1.50
#PTOUCH_NETWORK_PORT=9100

# --- Labels ---
# Tape width in mm, used when a request does not specify one.
PTOUCH_TAPE_MM=24
# Blank tape fed before and after each label. 2mm is the printer's own minimum.
PTOUCH_MARGIN_MM=2

# Feed and cut the ~24mm of tape between the print head and the cutter before
# printing, so labels do not carry a long blank leader. Costs one small scrap per
# job. This is what Brother's own driver does.
PTOUCH_PRECUT=1

# Half cut: cut the label but leave the backing paper intact, so labels stay on one
# strip and peel off individually. Unset follows the printer's capability; printers
# that cannot do it (PT-P710BT) always get full cuts.
#PTOUCH_HALF_CUT=1
# Font. Accepts a path, or an alias: helsinki, helsinki-bold, helsinki-narrow,
# brussels. Helsinki is P-touch's own face and is picked up automatically if
# P-touch Editor is installed; otherwise the default is Nimbus Sans.
#PTOUCH_FONT=helsinki

# --- Limits ---
PTOUCH_MAX_COPIES=20
PTOUCH_MAX_TEXT=200

# --- Server ---
PTOUCH_LISTEN_HOST=0.0.0.0
PTOUCH_PORT=8080
PTOUCH_DRY_RUN_DIR=/tmp/ptouch-mcp

# --- Connection ---
# These printers accept one TCP session at a time, so a busy socket is transient.
PTOUCH_CONNECT_RETRIES=4
PTOUCH_CONNECT_TIMEOUT=5
